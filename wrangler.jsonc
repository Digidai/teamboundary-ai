{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teamboundary-target-control",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-02",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_ENV": "production",
    "AUTH_MODE": "access",
    "AI_ENABLED": "false",
    "PROVISIONING_MODE": "closed",
  },
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "teamboundary-target-control",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "ACCOUNT_RATE_LIMITER",
      "namespace_id": "000003",
      "simple": { "limit": 1000, "period": 60 },
    },
    {
      "name": "REQUEST_RATE_LIMITER",
      "namespace_id": "000000",
      "simple": { "limit": 240, "period": 60 },
    },
    {
      "name": "MUTATION_RATE_LIMITER",
      "namespace_id": "000001",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "000002",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "workflows": [
    {
      "name": "teamboundary-target-run-workflow",
      "binding": "RUN_WORKFLOW",
      "class_name": "RunWorkflow",
    },
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "invocation_logs": false,
      "persist": true,
    },
    "traces": { "enabled": true, "head_sampling_rate": 0.01, "persist": true },
  },
}
