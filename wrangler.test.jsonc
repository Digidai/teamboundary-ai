{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teamboundary-workerd-test",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-02",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "development",
    "AUTH_MODE": "dev",
    "AI_ENABLED": "false",
    "PROVISIONING_MODE": "personal",
  },
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "teamboundary-workerd-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "ACCOUNT_RATE_LIMITER",
      "namespace_id": "990000",
      "simple": { "limit": 1000, "period": 60 },
    },
    {
      "name": "REQUEST_RATE_LIMITER",
      "namespace_id": "990001",
      "simple": { "limit": 240, "period": 60 },
    },
    {
      "name": "MUTATION_RATE_LIMITER",
      "namespace_id": "990002",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "990003",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
}
